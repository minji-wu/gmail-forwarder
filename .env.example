# Source Gmail account. This is the mailbox that will be searched.
FORWARD_SOURCE_USER=source@gmail.com

# Gmail app password for the source account.
# Do not use your normal Google password.
FORWARD_SOURCE_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Destination email address that should receive forwarded messages.
FORWARD_DESTINATION_EMAIL=destination@gmail.com

# Optional defaults. CLI flags override these values.
# FORWARD_SUBJECT=Payment confirmation
# FORWARD_FROM=example.com
# FORWARD_SINCE=01-Jan-2026
# FORWARD_BEFORE=01-Feb-2026
# FORWARD_LIMIT=25
# FORWARD_DRY_RUN=1
# FORWARD_STATE_FILE=.gmail_forwarder_state.json
